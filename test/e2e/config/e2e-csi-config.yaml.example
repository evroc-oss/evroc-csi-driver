# EVROC CSI Driver E2E Test Configuration
# This configuration is used for end-to-end testing with real credentials
#
# INSTRUCTIONS:
# 1. Copy this file to e2e-csi-config.yaml
# 2. Replace all YOUR_*_HERE placeholders with actual values
# 3. The e2e-csi-config.yaml file is gitignored to protect credentials

auth:
  # Create SA:         evroc iam serviceaccount create csi-e2e
  # Create credential: evroc iam serviceaccount credential create csi-e2e-key --service-account csi-e2e
  # Assign role:
  #   evroc iam rolebinding assign --principal "/iam/projects/<project-id>/serviceAccounts/csi-e2e" --role /iam/roles/kubernetesCSIAgent
  service_account_id: "csi-e2e"
  service_account_secret: "your-jwk-private-key-from-credential-create"

context:
  organization: "YOUR_ORG_ID_HERE"
  project: "YOUR_PROJECT_ID_HERE"
  region: "se-sto"

csi:
  # CSI driver identifier
  identifier: "evroc-csi-driver"

  # Maximum volumes per node
  maxVolumesPerNode: 128

  # Total storage capacity quota in GB
  totalCapacityGB: 1000